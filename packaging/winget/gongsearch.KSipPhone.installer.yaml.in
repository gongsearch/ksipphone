# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
PackageIdentifier: gongsearch.KSipPhone
PackageVersion: @VERSION@
InstallerType: nullsoft
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
Protocols:
  - tel
  - sip
  - sips
  - callto
ReleaseDate: @DATE@
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/gongsearch/ksipphone/releases/download/v@VERSION@/KSipPhone-@VERSION@-setup.exe
    InstallerSha256: @SHA256@
ManifestType: installer
ManifestVersion: 1.10.0
