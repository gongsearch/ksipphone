[Global]
IconName=call-start
Name=KSipPhone
Comment=SIP phone

[Event/incomingCall]
Name=Incoming call
Comment=Someone is calling
Action=Popup

[Event/callWaiting]
Name=Call waiting
Comment=Someone calls during a call
Action=Popup

[Event/missedCall]
Name=Missed call
Comment=A call was not answered
Action=Popup
Urgency=Normal
ShowInHistory=true

[Event/newVoicemail]
Name=New voice message
Comment=A caller left a voice message
Action=Popup
ShowInHistory=true
